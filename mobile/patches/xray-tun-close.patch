+
+func (u *udpConnectionHandler) Close() error {
+	u.Lock()
+	defer u.Unlock()
+	u.closed = true
+	for _, conn := range u.udpConns {
+		conn.queue.close()
+	}
+	clear(u.udpConns)
+	return nil
 }
 
